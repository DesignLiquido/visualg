{
    "compilerOptions": {
        "paths": {
            "@designliquido/delegua": ["./node_modules/@designliquido/delegua/dist"],
            "@designliquido/delegua/*": ["./node_modules/@designliquido/delegua/dist/*"],
            // Para linkagem (`yarn link ...`), comente as linhas acima e descomente as linhas abaixo.
            // "@designliquido/delegua": ["./node_modules/@designliquido/delegua/fontes"],
            // "@designliquido/delegua/*": ["./node_modules/@designliquido/delegua/fontes/*"],
        },
        "outDir": "dist",
        "module": "CommonJS",
        "moduleResolution": "bundler",
        "target": "es2017",
        "rootDir": "fontes",
        "strict": false,
        "types": ["node", "jest"],
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true
    },
    "exclude": [
        "babel.config.js", 
        "coverage",
        "docs",
        "dist/**/*",
        "jest.config.ts",
        "node_modules",
        "testes"
    ]
}
